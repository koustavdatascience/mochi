{
  "manifest_version": 3,
  "name": "Mochi",
  "version": "0.3.1",
  "description": "A tiny animated cat companion for your browser tabs.",
  "action": {
    "default_title": "Mochi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/mochi-icon-16.png",
      "32": "assets/mochi-icon-32.png",
      "48": "assets/mochi-icon-48.png",
      "128": "assets/mochi-icon-128.png"
    }
  },
  "icons": {
    "16": "assets/mochi-icon-16.png",
    "32": "assets/mochi-icon-32.png",
    "48": "assets/mochi-icon-48.png",
    "128": "assets/mochi-icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["cat.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.gif", "assets/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
